# =========================================================
# Default: treat all text files as text, normalize to LF
# =========================================================
* text=auto eol=lf

# =========================================================
# Explicit LF (critical for shell scripts & config files)
# =========================================================
*.sh        text eol=lf
*.bash      text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf

# =========================================================
# PHP / Blade / Frontend
# =========================================================
*.php       text eol=lf diff=php
*.blade.php text eol=lf diff=html
*.css       text eol=lf diff=css
*.html      text eol=lf diff=html
*.md        text eol=lf diff=markdown
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.vue       text eol=lf
*.scss      text eol=lf
*.sass      text eol=lf

# =========================================================
# Binary files (never normalize, never diff)
# =========================================================
*.pem       binary
*.crt       binary
*.key       binary
*.cer       binary
*.der       binary
*.p12       binary
*.pfx       binary
*.jpg       binary
*.jpeg      binary
*.png       binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.mp4       binary
*.mp3       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary

# =========================================================
# Export ignore (for `git archive`)
# =========================================================
/.github         export-ignore
CHANGELOG.md     export-ignore
.styleci.yml     export-ignore
/docker/certs/   export-ignore

# =========================================================
# Generated files (don't show in diffs)
# =========================================================
package-lock.json     linguist-generated=true
yarn.lock             linguist-generated=true
composer.lock         -diff