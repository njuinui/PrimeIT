# ─────────────────────────────────────────────────────────────────────────────
# PrimeIT Workspace — PRODUCTION environment template.
# Copy to .env (or set these as real environment variables in your host) and fill in.
# Never commit the filled-in file.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=PrimeIT
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false                # MUST stay false in production
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com
TRUSTED_PROXIES=*              # you are behind a load balancer / reverse proxy

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database (MySQL / MariaDB / PostgreSQL recommended — not SQLite — for production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=primeit
DB_USERNAME=primeit
DB_PASSWORD=

# Sessions, cache, queue. Redis is strongly recommended; "database" also works.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
PERMISSION_CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Realtime (chat, notifications, live progress). Run: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=primeit
REVERB_APP_KEY=                # long random string; the SAME value goes in the frontend VITE_REVERB_APP_KEY
REVERB_APP_SECRET=             # long random string; backend only
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Files
FILESYSTEM_DISK=local          # profile photos use the "public" disk; run: php artisan storage:link

# Mail — employees are invited and passwords reset by email, so this must be real.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional: import Figma versions automatically.
FIGMA_TOKEN=
FIGMA_INCLUDE_AUTOSAVES=false

# First administrator. REQUIRED: there is no default password in production.
# Create it once with:  php artisan db:seed --force   (or: php artisan primeit:admin)
# Then remove ADMIN_PASSWORD from the environment and sign in to change it.
ADMIN_NAME="Your Name"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
SEED_DEMO=false
